# Copy to apps/web/.env.local for the web app. Leave the Supabase lines empty to run in demo mode (in-browser test data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# email or phone. Phone needs an SMS provider set up in Supabase Auth.
VITE_AUTH_METHOD=email

# Server secrets. Set these with: supabase secrets set --env-file supabase/.env
# Never put these in the web app or in git.
# TRADESAFE_MODE=mock or live. Mock fakes the escrow so you can test the full order flow.
TRADESAFE_MODE=mock
TRADESAFE_CLIENT_ID=
TRADESAFE_CLIENT_SECRET=
TRADESAFE_AUTH_URL=https://auth.tradesafe.co.za/oauth/token
# [CONFIRM] sandbox GraphQL URL from your TradeSafe developer account
TRADESAFE_API_URL=https://api-developer.tradesafe.dev/graphql
TRADESAFE_CALLBACK_SECRET=
# Our TradeSafe agent token id (the platform account that receives fees)
TRADESAFE_AGENT_TOKEN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
APP_URL=http://localhost:5173
